{
  "env": {
    "browser": true,
    "es6": true,
    "node": true
  },
  "extends": [
    "eslint:recommended",
    "plugin:@typescript-eslint/eslint-recommended",
    // "plugin:@typescript-eslint/recommended" // this is giving issues!
    "plugin:import/recommended",
    "plugin:import/electron",
    "plugin:import/typescript"
  ],
  "parser": "@typescript-eslint/parser",
  "settings": {
    "import/resolver": {
      "typescript": {
        "project": ["src/windows/tsconfig.json", "src/main/tsconfig.json"]
      }
    }
  },
  "rules": {
    "@typescript-eslint/ban-ts-comment": "off",
    "no-empty": "off",
    "prefer-const": "warn",
    "no-unused-vars": "off",
    "@typescript-eslint/no-empty-function": "off",
    // "consistent-return": "error",
    "@typescript-eslint/no-extra-semi": "off",
    "no-extra-semi": "off", // apparently still needed?
    // "no-console": "warn"
    "import/default": "off",
    "import/no-named-as-default-member": "off"
  }
}